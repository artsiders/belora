enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  COMPLETED
  CANCELLED_BY_CUSTOMER
  CANCELLED_BY_PRO
  CANCELLED_BY_ADMIN
  NO_SHOW
}

enum PaymentStatus {
  UNPAID
  DEPOSIT_PAID
  PAID
  REFUNDED
  PARTIALLY_REFUNDED
}

enum BookingEventType {
  CREATED
  CONFIRMED
  RESCHEDULED
  CANCELLED
  COMPLETED
  PAYMENT_RECEIVED
  REFUNDED
  NO_SHOW_MARKED
}

model Booking {
  id                   String           @id @default(cuid())
  bookingNumber        String           @unique
  venueId              String
  customerId           String
  userId               String?
  staffMemberId        String?
  status               BookingStatus    @default(PENDING_PAYMENT)
  paymentStatus        PaymentStatus    @default(UNPAID)
  startsAt             DateTime         // UTC
  endsAt               DateTime         // UTC
  durationMinutes      Int
  lockedUntil          DateTime?        // Verrou temporaire (ex: 10 min) pendant le paiement Stripe
  subtotalPriceMinor   Int              // Montant hors commissions/frais (en centimes)
  commissionFeeMinor   Int              @default(0)
  paymentFeeMinor      Int              @default(0)
  totalPriceMinor      Int              // Montant total TTC
  currency             String           @default("EUR")
  depositAmountMinor   Int              @default(0)
  paidAmountMinor      Int              @default(0)
  guestToken           String?          @unique
  customerNotes        String?          @db.Text
  cancellationReason   String?          @db.Text
  cancelledAt          DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  venue                Venue            @relation(fields: [venueId], references: [id], onDelete: Restrict)
  customer             CustomerProfile  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  user                 User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  staffMember          StaffMember?     @relation(fields: [staffMemberId], references: [id], onDelete: SetNull)
  items                BookingItem[]
  events               BookingEvent[]
  payments             Payment[]
  review               Review?

  @@index([bookingNumber])
  @@index([venueId, startsAt, endsAt])
  @@index([staffMemberId, startsAt, endsAt])
  @@index([status])
  @@index([customerId])
  @@index([userId])
  @@index([lockedUntil])
  @@map("bookings")
}

model BookingItem {
  id              String       @id @default(cuid())
  bookingId       String
  serviceId       String
  staffMemberId   String?
  serviceName     String       // Historisé au moment de la réservation
  durationMinutes Int
  priceMinorUnits Int
  startsAt        DateTime     // UTC
  endsAt          DateTime     // UTC
  order           Int          @default(0)
  createdAt       DateTime     @default(now())

  booking         Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service         Service      @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  staffMember     StaffMember? @relation(fields: [staffMemberId], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@index([serviceId])
  @@map("booking_items")
}

model BookingEvent {
  id          String           @id @default(cuid())
  bookingId   String
  type        BookingEventType
  actorType   String           // "CUSTOMER", "PRO", "ADMIN", "SYSTEM"
  actorId     String?
  description String
  metadata    Json?
  createdAt   DateTime         @default(now())

  booking     Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
  @@map("booking_events")
}
