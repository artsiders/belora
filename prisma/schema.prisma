// Belora Prisma Schema - PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum Role {
  CUSTOMER
  PRO
  ADMIN
}

enum VenueStatus {
  DRAFT
  PENDING_VALIDATION
  PUBLISHED
  SUSPENDED
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  REFUNDED
  FAILED
}

enum BookingChannel {
  MARKETPLACE // Réservation trouvée via la recherche / les pages Belora
  DIRECT_LINK // Lien direct du salon (site, réseaux sociaux, QR code)
  IN_SALON    // Rendez-vous saisi par le salon dans son agenda
}

enum CommissionMode {
  DISABLED              // Aucune commission
  NEW_CLIENTS_ONLY      // Uniquement les nouveaux clients apportés par la marketplace
  ALL_MARKETPLACE       // Toutes les réservations issues de la marketplace
}

enum CommissionBase {
  ONLINE_PAYMENT // Calculée sur le montant payé en ligne (acompte)
  BOOKING_TOTAL  // Calculée sur le prix total de la réservation
}

enum OnlinePaymentMode {
  NONE    // Aucun paiement en ligne : tout est réglé en salon
  DEPOSIT // Acompte en ligne, solde en salon
  FULL    // Totalité réglée en ligne
}

enum DepositScope {
  FLAGGED_SERVICES // Seulement les prestations qui exigent un acompte
  ALL_SERVICES     // Toutes les prestations
}

enum BillingInterval {
  MONTHLY
  ANNUAL
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum PaymentMethod {
  CARD_ONLINE
  CARD_TERMINAL
  CASH
  MIXED
}

// -----------------------------------------------------------------------------
// AUTHENTIFICATION & UTILISATEURS (NextAuth v5 / Auth.js)
// -----------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String?
  firstName     String
  lastName      String
  phone         String?
  role          Role      @default(CUSTOMER)
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  ownedVenues   Venue[]        @relation("VenueOwner")
  staffProfiles StaffMember[]
  crmProfiles   CustomerCRM[]
  reviews       Review[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// -----------------------------------------------------------------------------
// ÉTABLISSEMENT / SALON
// -----------------------------------------------------------------------------

model Venue {
  id                   String      @id @default(cuid())
  slug                 String      @unique
  name                 String
  tagline              String?
  description          String?     @db.Text
  address              String
  city                 String
  postalCode           String
  countryCode          String      @default("FR")
  latitude             Float
  longitude            Float
  phone                String?
  email                String?
  currency             String      @default("EUR")
  timezone             String      @default("Europe/Paris")
  status               VenueStatus @default(PUBLISHED)
  stripeAccountId      String?
  stripeChargesEnabled Boolean     @default(false)
  commissionRate       Float?      // Taux négocié (null = taux du forfait ou taux plateforme)
  commissionRateUntil  DateTime?   // Fin du taux négocié (null = sans limite)
  ownerId              String
  siret                String?
  vatNumber            String?
  website              String?
  cancellationDelayHours Int       @default(24)
  depositPercentage    Int         @default(30)
  onlinePaymentMode    OnlinePaymentMode @default(DEPOSIT)
  depositScope         DepositScope @default(FLAGGED_SERVICES)
  onlineBookingEnabled Boolean     @default(true)
  minBookingNoticeMinutes Int      @default(60)  // Délai minimum avant un rendez-vous réservé en ligne
  maxBookingAdvanceDays Int        @default(90)  // Horizon de réservation en ligne
  slotStepMinutes      Int         @default(15)  // Pas des créneaux proposés
  bufferMinutes        Int         @default(0)   // Battement après chaque rendez-vous
  allowStaffChoice     Boolean     @default(true) // Le client peut choisir son artisan
  cashSettings         Json?
  notificationSettings Json?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  owner             User               @relation("VenueOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  openingHours      VenueOpeningHour[]
  closures          VenueClosure[]
  staff             StaffMember[]
  resources         Resource[]
  serviceCategories ServiceCategory[]
  services          Service[]
  customers         CustomerCRM[]
  bookings          Booking[]
  saleTickets       SaleTicket[]
  dailyClosings     DailyClosing[]
  reviews           Review[]
  subscription      VenueSubscription?

  @@map("venues")
}

model VenueOpeningHour {
  id        String  @id @default(cuid())
  venueId   String
  dayOfWeek Int     // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
  openTime  String  // "09:00"
  closeTime String  // "19:00"
  isOpen    Boolean @default(true)
  breakStart String? // Fermeture en milieu de journée (ex : "12:30")
  breakEnd   String?

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@unique([venueId, dayOfWeek])
  @@map("venue_opening_hours")
}

/// Fermeture exceptionnelle (congés, jours fériés, travaux) : aucune réservation en ligne.
model VenueClosure {
  id        String   @id @default(cuid())
  venueId   String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  label     String?
  createdAt DateTime @default(now())

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId, startDate, endDate])
  @@map("venue_closures")
}

// -----------------------------------------------------------------------------
// ÉQUIPE & PLANNING (STAFF)
// -----------------------------------------------------------------------------

model StaffMember {
  id        String   @id @default(cuid())
  venueId   String
  userId    String?
  name      String
  role      String   // "Maître Coiffeur", "Artisan Coloriste", "Gérante"
  color     String   // Badge color for agenda e.g. "#82385a", "#b45309"
  avatarUrl String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  venue        Venue           @relation(fields: [venueId], references: [id], onDelete: Cascade)
  user         User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  schedules    StaffSchedule[]
  timeOffs     StaffTimeOff[]
  clockIns     StaffClockIn[]
  bookingItems BookingItem[]

  @@map("staff_members")
}

model StaffSchedule {
  id          String   @id @default(cuid())
  staffId     String
  dayOfWeek   Int      // 0-6
  plannedStart String  // "09:00"
  plannedEnd   String  // "19:00"
  breakStart   String? // "13:00"
  breakEnd     String? // "14:00"
  isActive    Boolean  @default(true)

  staff StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, dayOfWeek])
  @@map("staff_schedules")
}

model StaffTimeOff {
  id        String   @id @default(cuid())
  staffId   String
  startDate DateTime
  endDate   DateTime
  reason    String?

  staff StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@map("staff_time_offs")
}

model StaffClockIn {
  id           String    @id @default(cuid())
  staffId      String
  date         DateTime  @db.Date
  clockInTime  DateTime
  clockOutTime DateTime?

  staff StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@map("staff_clock_ins")
}

// -----------------------------------------------------------------------------
// RESSOURCES MATÉRIELLES (CABINES / FAUTEUILS / BACS)
// -----------------------------------------------------------------------------

model Resource {
  id       String  @id @default(cuid())
  venueId  String
  name     String  // "Fauteuil 1", "Cabine Soin Cuir Chevelu", "Bac Shampoing 1"
  type     String  // "Fauteuil", "Cabine", "Bac"
  color    String?
  isActive Boolean @default(true)

  venue        Venue         @relation(fields: [venueId], references: [id], onDelete: Cascade)
  bookingItems BookingItem[]

  @@map("resources")
}

// -----------------------------------------------------------------------------
// PRESTATIONS & CATALOGUE
// -----------------------------------------------------------------------------

model ServiceCategory {
  id      String @id @default(cuid())
  venueId String
  name    String
  order   Int    @default(0)

  venue    Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)
  services Service[]

  @@map("service_categories")
}

model Service {
  id                    String  @id @default(cuid())
  venueId               String
  categoryId            String
  name                  String
  description           String? @db.Text
  durationMinutes       Int     // Ex: 60 minutes
  processingTimeMinutes Int     @default(0) // Temps de pose (libère le coiffeur)
  priceCents            Int     // En centimes (ex: 8500 = 85.00 €)
  depositRequired       Boolean @default(true)
  depositCents          Int     @default(0) // En centimes (ex: 2500 = 25.00 €)
  order                 Int     @default(0)
  isActive              Boolean @default(true)

  venue        Venue           @relation(fields: [venueId], references: [id], onDelete: Cascade)
  category     ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  bookingItems BookingItem[]

  @@map("services")
}

// -----------------------------------------------------------------------------
// FICHIER CLIENTS CRM
// -----------------------------------------------------------------------------

model CustomerCRM {
  id             String    @id @default(cuid())
  venueId        String
  userId         String?
  firstName      String
  lastName       String
  phone          String
  email          String?
  isVip          Boolean   @default(false)
  notes          String?   @db.Text
  techFormulas   Json?     // Ex: { "coloration": "Majirel 6.34 + 20vol", "diagnostic": "Sensible" }
  totalVisits    Int       @default(0)
  totalSpentCents Int      @default(0)
  lastVisitAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  venue    Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)
  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  bookings Booking[]

  @@index([venueId, phone])
  @@index([venueId, email])
  @@map("customer_crm")
}

// -----------------------------------------------------------------------------
// RÉSERVATIONS (BOOKINGS)
// -----------------------------------------------------------------------------

model Booking {
  id                    String        @id @default(cuid())
  reference             String        @unique // Ex: "#BEL-8492"
  venueId               String
  customerId            String?
  clientName            String
  clientPhone           String
  clientEmail           String?
  status                BookingStatus @default(CONFIRMED)
  totalPriceCents       Int
  depositCents          Int           @default(0)
  remainingCents        Int           @default(0)
  paymentStatus         PaymentStatus @default(PENDING)
  stripePaymentIntentId String?
  channel               BookingChannel @default(MARKETPLACE)
  isNewClient           Boolean       @default(false)
  commissionRate        Float         @default(0)
  commissionCents       Int           @default(0) // Commission Belora totale due
  commissionCollectedCents Int        @default(0) // Part prélevée automatiquement au paiement en ligne
  paymentFeeCents       Int           @default(0) // Frais de paiement plateforme
  notes                 String?       @db.Text
  cancellationReason    String?
  cancelledAt           DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  venue       Venue         @relation(fields: [venueId], references: [id], onDelete: Cascade)
  customer    CustomerCRM?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items       BookingItem[]
  saleTickets SaleTicket[]
  review      Review?

  @@index([venueId, status])
  @@index([venueId, createdAt])
  @@map("bookings")
}

model BookingItem {
  id         String   @id @default(cuid())
  bookingId  String
  serviceId  String
  staffId    String
  resourceId String?
  startTime  DateTime // UTC
  endTime    DateTime // UTC
  priceCents Int

  booking  Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service  Service      @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  staff    StaffMember  @relation(fields: [staffId], references: [id], onDelete: Restrict)
  resource Resource?    @relation(fields: [resourceId], references: [id], onDelete: SetNull)

  @@index([staffId, startTime, endTime])
  @@index([resourceId, startTime, endTime])
  @@map("booking_items")
}

// -----------------------------------------------------------------------------
// VERROUILLAGE ANTI-COLLISION (10 MINUTES DANS PANIER)
// -----------------------------------------------------------------------------

model HoldingLock {
  id        String   @id @default(cuid())
  lockKey   String   @unique // Ex: "venue:staff:slot_timestamp"
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@map("holding_locks")
}

// -----------------------------------------------------------------------------
// CAISSE POS & CLÔTURE FISCALE Z
// -----------------------------------------------------------------------------

model SaleTicket {
  id                  String        @id @default(cuid())
  ticketNumber        String        @unique // Ex: "TK-2026-0042"
  venueId             String
  bookingId           String?
  clientName          String
  totalTtcCents       Int
  subtotalHtCents     Int
  vatAmountCents      Int
  paymentMethod       PaymentMethod
  cardAmountCents     Int           @default(0)
  cashAmountCents     Int           @default(0)
  depositDeductedCents Int          @default(0)
  createdAt           DateTime      @default(now())

  venue   Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([venueId, createdAt])
  @@map("sale_tickets")
}

model DailyClosing {
  id                 String   @id @default(cuid())
  venueId            String
  date               DateTime @db.Date
  totalTtcCents      Int
  totalHtCents       Int
  vatAmountCents     Int
  totalCardCents     Int
  totalCashCents     Int
  totalDepositsCents Int
  cashCountedCents   Int
  discrepancyCents   Int      @default(0)
  closedAt           DateTime @default(now())

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@unique([venueId, date])
  @@map("daily_closings")
}

// -----------------------------------------------------------------------------
// AVIS CLIENTS VÉRIFIÉS
// -----------------------------------------------------------------------------

model Review {
  id         String    @id @default(cuid())
  venueId    String
  bookingId  String    @unique
  userId     String?
  authorName String
  rating     Int       // 1 to 5
  comment    String    @db.Text
  isVerified Boolean   @default(true)
  reply      String?   @db.Text
  replyAt    DateTime?
  createdAt  DateTime  @default(now())

  venue   Venue   @relation(fields: [venueId], references: [id], onDelete: Cascade)
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([venueId, rating])
  @@map("reviews")
}

// -----------------------------------------------------------------------------
// PARAMÈTRES PLATEFORME BELORA
// -----------------------------------------------------------------------------

model PlatformSetting {
  id                    String         @id @default(cuid())
  defaultCommissionRate Float          @default(0.018) // Taux plateforme par défaut
  commissionMode        CommissionMode @default(NEW_CLIENTS_ONLY)
  commissionBase        CommissionBase @default(BOOKING_TOTAL)
  commissionMinCents    Int            @default(0)   // Commission minimale par réservation commissionnée
  commissionMaxCents    Int?                         // Plafond par réservation (null = sans plafond)
  paymentFeePercent     Float          @default(0)   // Frais de paiement plateforme (ex : 0.015)
  paymentFeeFixedCents  Int            @default(0)   // Part fixe des frais de paiement
  defaultTrialDays      Int            @default(14)
  defaultPlanId         String?                      // Forfait attribué si aucun n'est choisi
  salesContactEmail     String?                      // Contact commercial (forfaits sur devis)
  maintenanceMode       Boolean        @default(false)
  updatedAt             DateTime       @updatedAt

  @@map("platform_settings")
}

// -----------------------------------------------------------------------------
// FORFAITS & ABONNEMENTS PROFESSIONNELS
// -----------------------------------------------------------------------------

model SubscriptionPlan {
  id                     String   @id @default(cuid())
  slug                   String   @unique
  name                   String
  description            String?
  monthlyPriceCents      Int      // Prix HT mensuel, sans engagement
  annualPriceCents       Int      // Prix HT mensuel équivalent, engagement annuel
  currency               String   @default("EUR")
  trialDays              Int?     // null = durée d'essai plateforme
  maxStaff               Int?     // null = illimité
  maxResources           Int?     // null = illimité
  maxVenues              Int?     // null = illimité
  commissionRate         Float?   // null = taux plateforme
  includesSmsReminders   Boolean  @default(true)
  includesAnalytics      Boolean  @default(false)
  includesPriorityListing Boolean @default(false)
  features               String[] // Arguments affichés sur la page tarifs
  isHighlighted          Boolean  @default(false)
  highlightLabel         String?
  isContactSales         Boolean  @default(false) // Forfait sur devis : pas d'inscription directe
  isPublic               Boolean  @default(true)  // Affiché sur la page tarifs
  isActive               Boolean  @default(true)  // Souscriptible
  order                  Int      @default(0)
  stripeProductId        String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  subscriptions VenueSubscription[]

  @@map("subscription_plans")
}

model VenueSubscription {
  id                   String             @id @default(cuid())
  venueId              String             @unique
  planId               String
  status               SubscriptionStatus @default(TRIALING)
  interval             BillingInterval    @default(MONTHLY)
  trialEndsAt          DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  isComplimentary      Boolean            @default(false) // Offert par l'équipe Belora (pas de facturation)
  stripeCustomerId     String?
  stripeSubscriptionId String?            @unique
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  venue Venue            @relation(fields: [venueId], references: [id], onDelete: Cascade)
  plan  SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([status])
  @@map("venue_subscriptions")
}
